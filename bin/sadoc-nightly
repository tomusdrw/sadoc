#!/usr/bin/env bash
# Nightly runner for sadoc.
#
#   1. scan   - refresh the outdated-dependency inventory
#   2. run    - pick the highest-value repos and open PRs
#   3. monitor - chase CI and review feedback on PRs opened earlier
#   4. report - write a markdown digest
#
# The window is a hard wall-clock budget: no new repo is started when there is not
# enough time left for it to finish.
set -uo pipefail

# The install directory is derived from the script's own location, so the
# nightly runner works wherever it was installed.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SADOC_HOME="${SADOC_HOME:-$(dirname "$SCRIPT_DIR")}"
SADOC_BIN="$SADOC_HOME/bin/sadoc"
CONFIG="${SADOC_CONFIG:-$HOME/.config/sadoc/config.toml}"
LOG_DIR="${SADOC_LOG_DIR:-$HOME/.local/share/sadoc/logs}"
REPORT_DIR="${SADOC_REPORT_DIR:-$HOME/.local/share/sadoc/reports}"
STATE_DB="${SADOC_DB:-$HOME/.local/share/sadoc/state.db}"

if [ ! -x "$SADOC_BIN" ]; then
  echo "sadoc not found at $SADOC_BIN" >&2
  exit 1
fi

mkdir -p "$LOG_DIR" "$REPORT_DIR"
STAMP="$(date +%Y%m%d-%H%M%S)"
LOG="$LOG_DIR/$STAMP.log"

log() { printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*" | tee -a "$LOG"; }

run() {
  log ">>> $*"
  "$@" 2>&1 | tee -a "$LOG"
  local rc="${PIPESTATUS[0]}"
  log "<<< exit $rc"
  return "$rc"
}

# Self-update ---------------------------------------------------------------
# Sadoc updates itself from the latest main branch before it does anything
# else. If it pulled something new, the script starts again so that the code
# which runs is the code that was just fetched - bash reads a script as it
# goes, so continuing in place would be reading a file that changed under it.
if [ "${SADOC_SELF_UPDATE:-1}" = "1" ] && [ "${SADOC_REEXEC:-0}" != "1" ]; then
  log "=== self-update ==="
  "$SADOC_BIN" selfupdate 2>&1 | tee -a "$LOG"
  UPDATE_RC="${PIPESTATUS[0]}"
  if [ "$UPDATE_RC" = "10" ]; then
    log "updated - starting again with the new version"
    SADOC_REEXEC=1 exec "$0" "$@"
  elif [ "$UPDATE_RC" != "0" ]; then
    log "could not update; continuing with the current version"
  fi
fi

# Window helpers -----------------------------------------------------------
window_from_config() {
  python3 - "$CONFIG" <<'PY' 2>/dev/null || echo "01:00-07:00"
import sys, tomllib
try:
    with open(sys.argv[1], "rb") as fh:
        cfg = tomllib.load(fh)
    print(cfg.get("schedule", {}).get("window", "01:00-07:00"))
except Exception:
    print("01:00-07:00")
PY
}

WINDOW="$(window_from_config)"
WINDOW_START="${WINDOW%%-*}"
WINDOW_END="${WINDOW##*-}"

minutes_now() { date +%H%M | awk '{print int(substr($0,1,2))*60 + int(substr($0,2))}'; }
to_minutes() { echo "$1" | awk -F: '{print $1*60 + $2}'; }

WSTART=$(to_minutes "$WINDOW_START")
WEND=$(to_minutes "$WINDOW_END")
NOW=$(minutes_now)

# The deadline is the next time the clock reaches the end of the window.
if [ "$WEND" -gt "$NOW" ]; then
  DELTA_MIN=$((WEND - NOW))
else
  DELTA_MIN=$((1440 - NOW + WEND))
fi
DEADLINE=$(( $(date +%s) + DELTA_MIN * 60 ))
TOTAL_MIN=$(( (WEND - WSTART + 1440) % 1440 ))
[ "$TOTAL_MIN" -eq 0 ] && TOTAL_MIN=1440

log "window $WINDOW - ${DELTA_MIN} min remaining of ${TOTAL_MIN}"
log "deadline $(date -d "@$DEADLINE" +%H:%M:%S)"

log "=== scan ==="
run "$SADOC_BIN" --config "$CONFIG" --db "$STATE_DB" scan || true

log "=== run ==="
run "$SADOC_BIN" --config "$CONFIG" --db "$STATE_DB" run --deadline "$DEADLINE" || true

log "=== doctor ==="
run "$SADOC_BIN" --config "$CONFIG" --db "$STATE_DB" doctor || true

log "=== monitor ==="
run "$SADOC_BIN" --config "$CONFIG" --db "$STATE_DB" monitor --deadline "$DEADLINE" || true

log "=== releases ==="
run "$SADOC_BIN" --config "$CONFIG" --db "$STATE_DB" releases --notify || true

log "=== report ==="
REPORT="$REPORT_DIR/$STAMP.md"
NOTE="Run at $STAMP."
# The global options have to come before the subcommand.
if "$SADOC_BIN" --config "$CONFIG" --db "$STATE_DB" report --out "$REPORT" --note "$NOTE" 2>&1 | tee -a "$LOG"; then
  log "report written to $REPORT"
else
  log "the report was not written"
fi
