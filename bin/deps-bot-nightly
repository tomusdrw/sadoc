#!/usr/bin/env bash
# Nightly runner for deps-bot.
#
#   1. scan   - refresh the outdated-dependency inventory
#   2. run    - pick the highest-value repos and open PRs
#   3. monitor - chase CI and review feedback on PRs opened earlier
#   4. report - write a markdown digest
#
# The window is a hard wall-clock budget: no new repo is started when there is not
# enough time left for it to finish.
set -uo pipefail

# The install directory is derived from the script's own location, so the
# nightly runner works wherever it was installed.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEPSBOT_HOME="${DEPSBOT_HOME:-$(dirname "$SCRIPT_DIR")}"
DEPSBOT_BIN="$DEPSBOT_HOME/bin/deps-bot"
CONFIG="${DEPSBOT_CONFIG:-$HOME/.config/deps-bot/config.toml}"
LOG_DIR="${DEPSBOT_LOG_DIR:-$HOME/.local/share/deps-bot/logs}"
REPORT_DIR="${DEPSBOT_REPORT_DIR:-$HOME/.local/share/deps-bot/reports}"
STATE_DB="${DEPSBOT_DB:-$HOME/.local/share/deps-bot/state.db}"

if [ ! -x "$DEPSBOT_BIN" ]; then
  echo "deps-bot not found at $DEPSBOT_BIN" >&2
  exit 1
fi

mkdir -p "$LOG_DIR" "$REPORT_DIR"
STAMP="$(date +%Y%m%d-%H%M%S)"
LOG="$LOG_DIR/$STAMP.log"

log() { printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*" | tee -a "$LOG"; }

run() {
  log ">>> $*"
  "$@" 2>&1 | tee -a "$LOG"
  local rc="${PIPESTATUS[0]}"
  log "<<< exit $rc"
  return "$rc"
}

# Window helpers -----------------------------------------------------------
window_from_config() {
  python3 - "$CONFIG" <<'PY' 2>/dev/null || echo "01:00-07:00"
import sys, tomllib
try:
    with open(sys.argv[1], "rb") as fh:
        cfg = tomllib.load(fh)
    print(cfg.get("schedule", {}).get("window", "01:00-07:00"))
except Exception:
    print("01:00-07:00")
PY
}

WINDOW="$(window_from_config)"
WINDOW_START="${WINDOW%%-*}"
WINDOW_END="${WINDOW##*-}"

minutes_now() { date +%H%M | awk '{print int(substr($0,1,2))*60 + int(substr($0,2))}'; }
to_minutes() { echo "$1" | awk -F: '{print $1*60 + $2}'; }

WSTART=$(to_minutes "$WINDOW_START")
WEND=$(to_minutes "$WINDOW_END")
NOW=$(minutes_now)

# The deadline is the next time the clock reaches the end of the window.
if [ "$WEND" -gt "$NOW" ]; then
  DELTA_MIN=$((WEND - NOW))
else
  DELTA_MIN=$((1440 - NOW + WEND))
fi
DEADLINE=$(( $(date +%s) + DELTA_MIN * 60 ))
TOTAL_MIN=$(( (WEND - WSTART + 1440) % 1440 ))
[ "$TOTAL_MIN" -eq 0 ] && TOTAL_MIN=1440

log "window $WINDOW - ${DELTA_MIN} min remaining of ${TOTAL_MIN}"
log "deadline $(date -d "@$DEADLINE" +%H:%M:%S)"

log "=== scan ==="
run "$DEPSBOT_BIN" --config "$CONFIG" --db "$STATE_DB" scan || true

log "=== run ==="
run "$DEPSBOT_BIN" --config "$CONFIG" --db "$STATE_DB" run --deadline "$DEADLINE" || true

log "=== monitor ==="
run "$DEPSBOT_BIN" --config "$CONFIG" --db "$STATE_DB" monitor --deadline "$DEADLINE" || true

log "=== report ==="
REPORT="$REPORT_DIR/$STAMP.md"
"$DEPSBOT_BIN" report --config "$CONFIG" --db "$STATE_DB" --out "$REPORT" 2>&1 | tee -a "$LOG"
log "report written to $REPORT"
