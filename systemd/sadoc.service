[Unit]
Description=Run the sadoc dependency update agent
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/share/sadoc/bin/sadoc-nightly
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
Environment=PI_CODING_AGENT_DIR=%h/.cache/sadoc/pi-agent
EnvironmentFile=-%h/.config/sadoc/secrets.env
TimeoutStartSec=infinity
Nice=10
